<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nust.banking.ui.DashboardController"
      styleClass="main-container" spacing="15">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Top Header Bar & Telemetry Cards -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header-bar">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="BANKING &amp; FRAUD DETECTION ENGINE" styleClass="header-title"/>
            <Label text="Real-Time Concurrency Telemetry &amp; Multi-Threaded Settlement Pipeline" styleClass="header-subtitle"/>
        </VBox>

        <!-- Metric Cards -->
        <HBox spacing="10">
            <VBox styleClass="metric-card">
                <Label text="ENGINE STATUS" styleClass="metric-label"/>
                <Label fx:id="lblEngineStatus" text="ONLINE / RUNNING" styleClass="metric-value-green"/>
            </VBox>
            <VBox styleClass="metric-card">
                <Label text="TOTAL LIQUIDITY" styleClass="metric-label"/>
                <Label fx:id="lblTotalLiquidity" text="RS 0.00" styleClass="metric-value-blue"/>
            </VBox>
            <VBox styleClass="metric-card">
                <Label text="QUEUE DEPTH" styleClass="metric-label"/>
                <Label fx:id="lblQueueDepth" text="0 / 100" styleClass="metric-value"/>
            </VBox>
            <VBox styleClass="metric-card">
                <Label text="WORKER THREADS" styleClass="metric-label"/>
                <Label fx:id="lblActiveThreads" text="0 / 5 ACTIVE" styleClass="metric-value"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- Main Content Area: Split View -->
    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.40" styleClass="content-split-pane">

        <!-- Left Pane: Account Ledger -->
        <VBox spacing="10" styleClass="pane-box">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="ACCOUNT LEDGER" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnApplyInterest" text="Apply Monthly Interest" styleClass="btn-secondary"/>
                <Button fx:id="btnRefreshLedger" text="Refresh Ledger" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="tblAccounts" VBox.vgrow="ALWAYS" styleClass="custom-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colAccId" text="Account ID" prefWidth="90"/>
                    <TableColumn fx:id="colAccOwner" text="Owner Name" prefWidth="120"/>
                    <TableColumn fx:id="colAccType" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="colAccBalance" text="Balance (PKR)" prefWidth="110"/>
                    <TableColumn fx:id="colAccLockStatus" text="Lock State" prefWidth="90"/>
                </columns>
            </TableView>

            <!-- File Handling Actions -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnSaveLedgerCsv" text="Save Ledger (CSV)" styleClass="btn-secondary"/>
                <Button fx:id="btnLoadLedgerCsv" text="Load Ledger (CSV)" styleClass="btn-secondary"/>
                <Button fx:id="btnSaveSnapshot" text="Save Snapshot" styleClass="btn-secondary"/>
                <Button fx:id="btnLoadSnapshot" text="Load Snapshot" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- Right Pane: Controls & Transaction Stream -->
        <VBox spacing="15" styleClass="pane-box">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- Transfer Control Panel -->
            <TitledPane text="TRANSACTION EXECUTION &amp; STRATEGY PANEL" collapsible="false" styleClass="control-titled-pane">
                <GridPane hgap="10" vgap="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="22"/>
                        <ColumnConstraints percentWidth="28"/>
                        <ColumnConstraints percentWidth="22"/>
                        <ColumnConstraints percentWidth="28"/>
                    </columnConstraints>

                    <Label text="Source Account:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbSourceId" prefWidth="180" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Destination Account:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="cmbDestId" prefWidth="180" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="Transfer Amount (RS):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtAmount" promptText="e.g. 5000.00" text="5000.00" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Lock Strategy:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="cmbLockStrategy" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <!-- Status Feedback Message Row -->
                    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
                        <Label fx:id="lblStatusMessage" text="System Ready." style="-fx-font-weight: bold; -fx-text-fill: #38bdf8;"/>
                    </HBox>

                    <!-- Action Buttons Bar -->
                    <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4" alignment="CENTER_RIGHT">
                        <Button fx:id="btnExportAuditJson" text="Export Audit (JSON)" styleClass="btn-secondary"/>
                        <Button fx:id="btnExecuteTransfer" text="Execute Transfer" styleClass="btn-primary"/>
                        <Button fx:id="btnInjectVelocity" text="Inject Traffic" styleClass="btn-warning"/>
                        <Button fx:id="btnTriggerDeadlock" text="Simulate Deadlock" styleClass="btn-danger"/>
                        <Button fx:id="btnResetSystem" text="Reset System" styleClass="btn-secondary"/>
                    </HBox>
                </GridPane>
            </TitledPane>

            <!-- Live Transaction Stream Table -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="LIVE TRANSACTION STREAM &amp; SETTLEMENT PIPELINE" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTelemetryTps" text="TPS: 0.0" styleClass="metric-value-blue"/>
                    <Label fx:id="lblCompositeRisk" text="Risk: 0.0%" styleClass="metric-value"/>
                    <Label fx:id="lblThreatBadge" text="NORMAL / LOW" styleClass="metric-value-green"/>
                </HBox>
                <TableView fx:id="tblTransactions" VBox.vgrow="ALWAYS" styleClass="custom-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colTxId" text="Tx ID" prefWidth="80"/>
                        <TableColumn fx:id="colTxFrom" text="From" prefWidth="85"/>
                        <TableColumn fx:id="colTxTo" text="To" prefWidth="85"/>
                        <TableColumn fx:id="colTxAmount" text="Amount (PKR)" prefWidth="100"/>
                        <TableColumn fx:id="colTxStatus" text="Settlement Status" prefWidth="130"/>
                        <TableColumn fx:id="colTxRisk" text="Risk Score" prefWidth="70"/>
                        <TableColumn fx:id="colTxDetails" text="Engine Message &amp; Fraud Analysis" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>

    </SplitPane>
</VBox>
